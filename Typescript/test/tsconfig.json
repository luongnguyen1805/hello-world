{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,
    "esModuleInterop": true,

    "declaration": true,
    "declarationDir": "./build/types",
    "outDir": "./build",

    "sourceMap": true
  },
  "include": ["**/*.ts"]
}
